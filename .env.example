# Copy into your local secret manager or untracked .env; never commit credentials.
DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5432/invoice_agent
BLOB_ROOT=./backend/var/blobs
BLOB_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY=
# Prototype auto-login is only supported when PROTOTYPE_MODE=true; it is not available in normal mode.
PROTOTYPE_MODE=false
PROTOTYPE_AUTO_LOGIN=true
PROTOTYPE_USER_ID=local-operator
PROTOTYPE_USER_NAME=Jamie Davis
PROTOTYPE_TENANT_ID=00000000-0000-4000-8000-000000000001
OIDC_ISSUER=
OIDC_CALLBACK_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
SESSION_SECRET=
CSRF_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_ALLOWED_PROVIDERS=
EXTERNAL_PROVIDER_APPROVED=false
ALLOW_INSECURE_LOCAL_AUTH=false
WORKBOOK_PROFILE_APPROVED=false
RETENTION_DAYS=
EXTERNAL_DATA_RESIDENCY=
MAX_WORKBOOK_BYTES=52428800
MAX_CELL_TEXT_LENGTH=32767
CURRENCY_TOLERANCES_JSON={}
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000
